      "alwaysOutputData": true,
      "executeOnce": true,
      "id": "1746cf85-5bb4-44db-9906-693b767f58f2"
    },
    {
      "parameters": {
        "jsCode": "// WEEKLY STATS – what happened in the last 7 days (Job Tracker + Run Log)\nconst since = Date.now() - 7 * 24 * 60 * 60 * 1000;\nconst recent = (r) => new Date(r.createdAt).getTime() >= since;\nconst recentlyChanged = (r) => new Date(r.updatedAt || r.createdAt).getTime() >= since;\nconst jobs = $(\"Read Job Tracker\").all().map((i) => i.json).filter((j) => j.job_id);\nconst runs = $(\"Read Run Log\").all().map((i) => i.json).filter((r) => r.run_at && recent(r));\nconst added = jobs.filter(recent);\nconst st = (s) => jobs.filter((j) => recentlyChanged(j) && j.status === s).length;\nconst best = added.filter((j) => j.fit !== \"Red flag\" && ![\"skipped\", \"rejected\"].includes(j.status)).sort((a, b) => b.match_score - a.match_score)[0];\nconst failed = runs.filter((r) => r.status === \"FAILED\").length;\nconst tokens = runs.reduce((s, r) => s + (Number(r.ai_tokens) || 0), 0);\nconst okRuns = runs.filter((r) => r.duration_sec);\nconst row = {\n  week_ending: new Date().toLocaleDateString(\"en-GB\", { timeZone: \"Europe/London\" }),\n  jobs_added: added.length,\n  strong: added.filter((j) => j.fit === \"Strong\").length,\n  possible: added.filter((j) => j.fit === \"Possible\").length,\n  red_flags: added.filter((j) => j.fit === \"Red flag\").length,\n  applied: st(\"applied\"), interviews: st(\"interview\"), offers: st(\"offer\"),\n  runs: runs.length, failed_runs: failed, ai_tokens: tokens,\n  avg_run_sec: okRuns.length ? Math.round(okRuns.reduce((s, r) => s + Number(r.duration_sec), 0) / okRuns.length) : 0,\n  best_new_job: best ? `${best.title} – ${best.company} (${best.match_score})` : \"\",\n  note: [\n    runs.length < 5 ? `only ${runs.length} run(s) this week – was the laptop off at 8:05?` : \"\",\n    failed ? `${failed} failed run(s) – check the Run Log` : \"\",\n    added.filter((j) => j.fit === \"Strong\" && (j.status || \"new\") === \"new\").length ? `${added.filter((j) => j.fit === \"Strong\" && (j.status || \"new\") === \"new\").length} strong match(es) still waiting for you` : \"\"\n  ].filter(Boolean).join(\"; \")\n};\nreturn [{ json: row }];\n"
      },
      "name": "Weekly Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
