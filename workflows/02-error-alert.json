      ],
      "id": "d1655e38-b588-4099-8954-4c81c03c35c0"
    },
    {
      "parameters": {
        "jsCode": "// FORMAT ERROR – turns a crash of the AI Job Hunt Agent into a Run Log row\nconst e = $input.first().json;\nconst ex = e.execution || {};\nreturn [{ json: {\n  run_at: new Date().toLocaleString(\"en-GB\", { timeZone: \"Europe/London\" }),\n  trigger: ex.mode || \"\",\n  status: \"FAILED\",\n  notes: `${e.workflow?.name || \"Workflow\"} failed at \"${ex.lastNodeExecuted || \"?\"}\": ${ex.error?.message || \"unknown error\"} (execution ${ex.id || \"?\"})`.slice(0, 1000)\n} }];\n"
      },
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        96,
        256
      ],
      "id": "fe3dbc89-23a0-4279-abb3-25474d934a33"
    },
